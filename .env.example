# ============================================
# QuadStack Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- App Configuration ---
CLIENT_NAME=QuadStack
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key

# --- Database (PostgreSQL) ---
POSTGRES_USER=quadstack
POSTGRES_PASSWORD=quadstack_dev
POSTGRES_DB=quadstack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Staff keep the task dashboard open all shift, so their sign-in lasts longer (minutes)
STAFF_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_CLIENT_NAME=QuadStack

# --- Seed Admin (used by app/seed.py on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@quadstack.local
ADMIN_FULL_NAME=System Administrator

# --- Email notifications (owner <-> staff) ---
# Where the app is opened in a browser — used for the links inside emails
APP_BASE_URL=http://localhost:5173
# With Docker Compose, emails land in a local inbox at http://localhost:8025,
# so there is nothing to set. To send real email instead, remove the "#" from the
# lines below and fill them in. (Leave SMTP_HOST empty to switch email off; browser
# and in-app notifications keep working.)
#   Gmail: smtp.gmail.com, port 587, TLS on, and an "App password" as the password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=QuadStack <you@gmail.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
