# Copy to .env.prod on the server and fill in real values.
# Generate secrets with:  openssl rand -hex 32

CLIENT_NAME=QuadStack

# ":80" = plain HTTP on the server's public IP.
# Set to your domain (e.g. erp.example.com) for automatic HTTPS.
SITE_ADDRESS=:80

POSTGRES_USER=quadstack
POSTGRES_PASSWORD=
POSTGRES_DB=quadstack

SECRET_KEY=
JWT_SECRET_KEY=

# Password for the read-only role the Copilot uses
COPILOT_DB_PASSWORD=

# First admin login (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Optional: enables the Copilot (get a free key at console.groq.com)
GROQ_API_KEY=
