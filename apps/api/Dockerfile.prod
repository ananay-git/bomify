FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
# uvicorn reads WEB_CONCURRENCY as its worker count
ENV WEB_CONCURRENCY=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Migrate + seed (idempotent), then start without --reload
CMD ["sh", "-c", "python -m app.seed && uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]
